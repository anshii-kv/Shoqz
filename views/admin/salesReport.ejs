<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sales Report Dashboard - ZENVOGUE</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <!-- Chart.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
  <!-- jsPDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    body {
      background-color: #f8f9fa;
    }
    .container-fluid {
      padding: 20px;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    .page-title {
      font-size: 1.8rem;
      font-weight: 600;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }
    .stat-card {
      background: #fff;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      text-align: center;
    }
    .stat-icon {
      font-size: 1.5rem;
      color: #007bff;
      margin-bottom: 10px;
    }
    .stat-value {
      font-size: 1.8rem;
      font-weight: bold;
      color: #333;
    }
    .stat-label {
      font-size: 1rem;
      color: #6c757d;
    }
    .sales-table-container {
      background: #fff;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .table-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    .search-container {
      position: relative;
      width: 300px;
    }
    .search-icon {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: #6c757d;
    }
    .search-input {
      padding-left: 35px;
      width: 100%;
      height: 38px;
      border-radius: 5px;
    }
    .notification {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #28a745;
      color: #fff;
      padding: 10px 20px;
      border-radius: 5px;
      display: none;
      align-items: center;
      gap: 10px;
    }
    .notification.show {
      display: flex;
    }
    .dropdown-menu {
      min-width: 150px;
      border-radius: 5px;
    }
    .dropdown-item:hover {
      background-color: #f1f1f1;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <%-include("../../views/partials/admin/sidebar")%>
  <div class="container-fluid">
    <!-- Header -->
    <div class="page-header">
      <h1 class="page-title">
        <i class="fas fa-chart-line me-2"></i>
        Sales Report Dashboard
      </h1>
      <div class="export-buttons d-flex gap-2 align-items-center">
        <button id="exportExcel" class="btn btn-outline-secondary">
          <i class="fas fa-file-excel me-1"></i> Export Excel
        </button>
        <button id="exportPDF" class="btn btn-outline-secondary">
          <i class="fas fa-file-pdf me-1"></i> Export PDF
        </button>
        
        <!-- Custom Date Range Inputs (Hidden by Default) -->
        <div id="customDateRange" class="d-none align-items-center gap-2">
          <input type="date" id="startDate" class="form-control form-control-sm" style="width: 150px;">
          <span>to</span>
          <input type="date" id="endDate" class="form-control form-control-sm" style="width: 150px;">
          <button id="applyCustomFilter" class="btn btn-primary btn-sm">Apply</button>
        </div>

        <!-- Filter Button with Dropdown -->
        <div class="dropdown">
          <button id="filterBtn" class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-filter me-1"></i> 
            <span id="currentFilterText">
              <% if (currentFilter === 'today') { %>Today<% } %>
              <% if (currentFilter === 'weekly') { %>Weekly<% } %>
              <% if (currentFilter === 'monthly') { %>Monthly<% } %>
              <% if (currentFilter === 'custom') { %>Custom Range<% } %>
            </span>
          </button>
          <ul class="dropdown-menu" id="filterDropdown">
            <li><a class="dropdown-item" href="#" data-filter="today">Today</a></li>
            <li><a class="dropdown-item" href="#" data-filter="weekly">Weekly</a></li>
            <li><a class="dropdown-item" href="#" data-filter="monthly">Monthly</a></li>
            <li><a class="dropdown-item" href="#" data-filter="custom">Custom Range</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-content">
          <div class="stat-icon"><i class="fas fa-rupee-sign"></i></div>
          <div class="stat-value">₹<%= totalRevenue.toLocaleString() %></div>
          <div class="stat-label">Total Revenue</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-content">
          <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
          <div class="stat-value"><%= totalOrders %></div>
          <div class="stat-label">Total Orders</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-content">
          <div class="stat-icon"><i class="fas fa-tags"></i></div>
          <div class="stat-value">₹<%= totalDiscounts.toLocaleString() %></div>
          <div class="stat-label">Total Discounts</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-content">
          <div class="stat-icon"><i class="fas fa-chart-bar"></i></div>
          <div class="stat-value">₹<%= avgOrderValue %></div>
          <div class="stat-label">Avg Order Value</div>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="table-responsive mt-4">
      <table class="table table-striped table-bordered" id="salesReportTable">
        <thead class="table-dark">
          <tr>
            <th>Order ID</th>
            <th>Date</th>
            <th>Customer Name</th>
            <th>Original Price (₹)</th>
            <th>Coupon Discount (₹)</th>
            <th>Offer Discount (₹)</th>
            <th>Delivery Charge (₹)</th>
            <th>Final Price (₹)</th>
            <th>Payment Method</th>
          </tr>
        </thead>
       <!-- In your table body section -->
<tbody>
 <% if (recentOrders && recentOrders.length > 0) { %>
  <% recentOrders.forEach(order => { %>
    <tr>
      <td><%= order.orderId %></td>
      <td><%= order.date %></td>
      <td><%= order.customerName %></td>

      <!-- Loop products for salePrice -->
      <td>
        <% if (order.products && order.products.length > 0) { %>
          <% order.products.forEach(p => { %>
            <div><%= p.name %> → ₹<%= p.salePrice %></div>
          <% }) %>
        <% } else { %>
          N/A
        <% } %>
      </td>

      <td>₹<%= order.couponDiscount %></td>
      <td>₹<%= order.offerDiscount %></td>
      <td>₹<%= order.deliveryCharge %></td>
      <td>₹<%= order.finalPrice %></td>
      <td><%= order.paymentMethod %></td>
    </tr>
  <% }) %>
<% } else { %>
  <tr>
    <td colspan="9" class="text-center">No orders available for the selected filter</td>
  </tr>
<% } %>

</tbody>
      </table>
    </div>

    <div id="notification" class="notification">
      <i class="fas fa-check-circle"></i>
      <span></span>
    </div>
  </div>

  <!-- Bootstrap JS and Popper.js -->
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
  
<script>
  // Filter functionality
  document.addEventListener('DOMContentLoaded', function() {
    const filterDropdownItems = document.querySelectorAll('#filterDropdown .dropdown-item');
    const customDateRange = document.getElementById('customDateRange');
    const currentFilterText = document.getElementById('currentFilterText');
    const startDateInput = document.getElementById('startDate');
    const endDateInput = document.getElementById('endDate');
    const applyCustomFilterBtn = document.getElementById('applyCustomFilter');

    // Set default dates for custom range
    const today = new Date();
    const oneWeekAgo = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
    
    startDateInput.value = oneWeekAgo.toISOString().split('T')[0];
    endDateInput.value = today.toISOString().split('T')[0];

    // Handle filter selection
    filterDropdownItems.forEach(item => {
      item.addEventListener('click', function(e) {
        e.preventDefault();
        const filter = this.dataset.filter;
        
        if (filter === 'custom') {
          // Show custom date range inputs
          customDateRange.classList.remove('d-none');
          currentFilterText.textContent = 'Custom Range';
        } else {
          // Hide custom date range and apply filter immediately
          customDateRange.classList.add('d-none');
          currentFilterText.textContent = this.textContent;
          applyFilter(filter);
        }
      });
    });

    // Apply custom filter
    applyCustomFilterBtn.addEventListener('click', function() {
      const startDate = startDateInput.value;
      const endDate = endDateInput.value;
      
      if (!startDate || !endDate) {
        alert('Please select both start and end dates');
        return;
      }
      
      if (new Date(startDate) > new Date(endDate)) {
        alert('Start date cannot be after end date');
        return;
      }
      
      applyFilter('custom', startDate, endDate);
    });

    // Filter function
    function applyFilter(filter, startDate = '', endDate = '') {
      const url = new URL(window.location.href);
      url.searchParams.set('filter', filter);
      
      if (filter === 'custom' && startDate && endDate) {
        url.searchParams.set('startDate', startDate);
        url.searchParams.set('endDate', endDate);
      } else {
        url.searchParams.delete('startDate');
        url.searchParams.delete('endDate');
      }
      
      // Show loading state
      currentFilterText.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
      
      // Reload page with new filter
      window.location.href = url.toString();
    }

    // Export functions
    function exportToExcel() {
      try {
        // Get the actual table data from the rendered HTML
        const table = document.getElementById('salesReportTable');
        const headers = [];
        const rows = [];

        // Get headers
        table.querySelectorAll('thead th').forEach(header => {
          headers.push(header.textContent.trim());
        });

        // Get rows data
        table.querySelectorAll('tbody tr').forEach(row => {
          const rowData = [];
          row.querySelectorAll('td').forEach(cell => {
            rowData.push(cell.textContent.trim());
          });
          rows.push(rowData);
        });

        // Create CSV content
        let csv = headers.join(',') + '\n';
        rows.forEach(row => {
          // Escape commas and quotes in data
          const escapedRow = row.map(field => {
            if (field.includes(',') || field.includes('"') || field.includes('\n')) {
              return '"' + field.replace(/"/g, '""') + '"';
            }
            return field;
          });
          csv += escapedRow.join(',') + '\n';
        });

        // Create and download file
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', 'sales_report.csv');
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        
        showNotification('Excel file exported successfully!');
      } catch (error) {
        console.error('Error exporting to Excel:', error);
        alert('Error exporting to Excel: ' + error.message);
      }
    }

function exportToPDF() {
  try {
    const { jsPDF } = window.jspdf;

    // Create new PDF document
    const doc = new jsPDF({
      orientation: 'landscape',
      unit: 'mm',
      format: 'a3'
    });

    // Title
    doc.setFontSize(18);
    doc.text('Sales Report - ZENVOGUE', 20, 20);

    // Get table data
    const table = document.getElementById('salesReportTable');
    const headers = [];
    const rows = [];

    // Extract headers
    table.querySelectorAll('thead th').forEach(header => {
      headers.push(header.textContent.trim());
    });

    // Extract rows
    table.querySelectorAll('tbody tr').forEach(row => {
      const rowData = [];
      row.querySelectorAll('td').forEach(cell => {
        rowData.push(cell.textContent.trim());
      });
      rows.push(rowData);
    });

    // PDF table settings
    doc.setFontSize(10);
    const margin = 20;
    const lineHeight = 8;
    const pageWidth = doc.internal.pageSize.width;
    const pageHeight = doc.internal.pageSize.height;

    const colWidth = (pageWidth - margin * 2) / headers.length;
    const colPositions = headers.map((_, i) => margin + i * colWidth);

    let yPosition = 40;

    // Draw headers with borders
    headers.forEach((header, i) => {
      doc.text(header, colPositions[i] + 2, yPosition);
      // Header cell border
      doc.rect(colPositions[i], yPosition - lineHeight + 2, colWidth, lineHeight, 'S');
    });

    yPosition += lineHeight;

    // Draw row data
    rows.forEach(row => {
      if (yPosition > pageHeight - 20) {
        doc.addPage();
        yPosition = 20;

        // redraw headers on new page
        headers.forEach((header, i) => {
          doc.text(header, colPositions[i] + 2, yPosition);
          doc.rect(colPositions[i], yPosition - lineHeight + 2, colWidth, lineHeight, 'S');
        });

        yPosition += lineHeight;
      }

      row.forEach((cell, i) => {
        const text = cell || '';
        const wrappedText = doc.splitTextToSize(text, colWidth - 4);

        // Place text
        doc.text(wrappedText, colPositions[i] + 2, yPosition);

        // Cell border
        doc.rect(colPositions[i], yPosition - lineHeight + 2, colWidth, lineHeight, 'S');
      });

      yPosition += lineHeight;
    });

    // Footer with date
    const exportDate = new Date().toLocaleString();
    doc.setFontSize(8);
    doc.text(`Exported on: ${exportDate}`, margin, pageHeight - 10);

    // Save file
    doc.save('sales_report.pdf');
    showNotification('PDF file exported successfully!');
  } catch (error) {
    console.error('Error exporting to PDF:', error);
    alert('Error exporting to PDF: ' + error.message);
  }
}



    // Notification helper
    function showNotification(message) {
      const notification = document.getElementById('notification');
      const span = notification.querySelector('span');
      span.textContent = message;
      notification.classList.add('show');
      setTimeout(() => notification.classList.remove('show'), 3000);
    }

    // Attach export button events
    document.getElementById('exportExcel').addEventListener('click', exportToExcel);
    document.getElementById('exportPDF').addEventListener('click', exportToPDF);
  });
</script>
</body>
</html>