<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Wallet - SHOQZ</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito Sans', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        .wallet-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .wallet-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .wallet-main-card {
            background: linear-gradient(135deg, #bdd5eb 0%, #a9c1d6 100%);
            border-radius: 25px;
            padding: 2.5rem;
            color: white;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(189, 213, 235, 0.3);
            transition: all 0.4s ease;
        }

        .wallet-main-card:hover {
            transform: translateY(-5px) rotateY(2deg);
            box-shadow: 0 30px 60px rgba(189, 213, 235, 0.4);
        }

        .wallet-main-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            transform: rotate(45deg);
            transition: all 0.6s ease;
        }

        .wallet-main-card:hover::before {
            transform: rotate(45deg) scale(1.2);
        }

        .wallet-content {
            position: relative;
            z-index: 2;
        }

        .wallet-chip {
            width: 40px;
            height: 30px;
            background: rgba(255,255,255,0.3);
            border-radius: 6px;
            margin-bottom: 1.5rem;
            position: relative;
        }

        .wallet-chip::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 20px;
            height: 15px;
            background: rgba(255,255,255,0.5);
            border-radius: 2px;
        }

        .balance-section {
            margin-bottom: 2rem;
        }

        .balance-label {
            font-size: 0.9rem;
            opacity: 0.8;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-family: 'Nunito Sans', sans-serif;
        }

        .balance-amount {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 1rem;
            font-family: 'Nunito Sans', sans-serif;
        }

        .wallet-number {
            font-family: 'Nunito Sans', sans-serif; /* Changed from Courier New */
            font-size: 1.1rem;
            letter-spacing: 3px;
            opacity: 0.9;
            margin-bottom: 1rem;
        }

        .wallet-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.9rem;
            opacity: 0.8;
            font-family: 'Nunito Sans', sans-serif;
        }

        .stats-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        }

        .stats-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stats-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #bdd5eb 0%, #a9c1d6 100%);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.3rem;
        }

        .stats-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #333;
            margin: 0;
            font-family: 'Nunito Sans', sans-serif;
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
            border-bottom: 1px solid #f1f3f4;
            transition: all 0.3s ease;
        }

        .stat-item:last-child {
            border-bottom: none;
        }

        .stat-item:hover {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            margin: 0 -1rem;
            padding: 1rem;
            border-radius: 12px;
        }

        .stat-label {
            color: #666;
            font-weight: 500;
            font-family: 'Nunito Sans', sans-serif;
        }

        .stat-value {
            font-weight: 700;
            color: #333;
            font-family: 'Nunito Sans', sans-serif;
        }

        .stat-value.positive {
            color: #28a745;
        }

        .transactions-section {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .transactions-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
            margin-bottom: 1rem;
        }

        .transactions-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #333;
            margin: 0;
            font-family: 'Nunito Sans', sans-serif;
        }

        .view-all-btn {
            background: linear-gradient(135deg, #bdd5eb 0%, #a9c1d6 100%);
            color: white;
            border: none;
            border-radius: 20px;
            padding: 0.5rem 1.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            font-family: 'Nunito Sans', sans-serif;
        }

        .view-all-btn:hover {
            background: linear-gradient(135deg, #a9c1d6 0%, #bdd5eb 100%);
            transform: translateY(-2px);
        }

        .transaction-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .transaction-item {
            display: flex;
            align-items: center;
            padding: 1rem;
            border-bottom: 1px solid #e9ecef;
            transition: all 0.3s ease;
        }

        .transaction-item:last-child {
            border-bottom: none;
        }

        .transaction-item:hover {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 10px;
        }

        .transaction-column {
            flex: 1;
            padding: 0 0.5rem;
            font-size: 0.95rem;
            color: #333;
            font-family: 'Nunito Sans', sans-serif;
        }

        .transaction-column.date {
            flex: 0.8;
            color: #666;
        }

        .transaction-column.description {
            flex: 2;
            font-weight: 600;
        }

        .transaction-column.type {
            flex: 0.8;
            text-transform: capitalize;
        }

        .transaction-column.amount {
            flex: 0.8;
            font-weight: 700;
            text-align: right;
        }

        .transaction-column.amount.positive {
            color: #28a745;
        }

        .transaction-column.amount.negative {
            color: #dc3545;
        }

        @media (max-width: 768px) {
            .wallet-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .wallet-main-card {
                padding: 2rem;
            }

            .balance-amount {
                font-size: 2.5rem;
            }

            .transaction-item {
                flex-wrap: wrap;
                gap: 0.5rem;
                padding: 0.8rem;
            }

            .transaction-column {
                font-size: 0.9rem;
            }

            .transaction-column.date,
            .transaction-column.type,
            .transaction-column.amount {
                flex: 1;
            }

            .transaction-column.description {
                flex: 100%;
                order: -1;
            }
        }

        @media (max-width: 576px) {
            body {
                padding: 1rem 0.5rem;
            }

            .wallet-main-card {
                padding: 1.5rem;
            }

            .stats-card,
            .transactions-section {
                padding: 1rem;
            }

            .balance-amount {
                font-size: 2rem;
            }

            .transaction-column {
                font-size: 0.85rem;
            }

            .transactions-title {
                font-size: 1.2rem;
            }

            .view-all-btn {
                padding: 0.4rem 1rem;
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>
    <div class="wallet-container">
        <!-- Wallet Grid -->
        <div class="wallet-grid">
            <!-- Main Wallet Card -->
            <div class="wallet-main-card">
                <div class="wallet-content">
                    <div class="wallet-chip"></div>
                    <div class="balance-section">
                        <div class="balance-label">Available Balance</div>
                        <div class="balance-amount">₹<%= balance.toFixed(2) %></div>
                    </div>
                    <div class="wallet-number">**** **** **** 2025</div>
                    <div class="wallet-meta">
                        <div>
                            <div>SHOQZ</div>
                            <div>Wallet</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Card -->
            <div class="stats-card">
                <div class="stats-header">
                    <div class="stats-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3 class="stats-title">Wallet Stats</h3>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Total Credits</span>
                    <span class="stat-value positive">₹<%= credits.toFixed(2) %></span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Total Debits</span>
                    <span class="stat-value">₹<%= debits.toFixed(2) %></span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">This Month</span>
                    <span class="stat-value <%= thisMonth >= 0 ? 'positive' : 'negative' %>">
                        <%= thisMonth >= 0 ? '+' : '' %>₹<%= thisMonth.toFixed(2) %>
                    </span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Transactions</span>
                    <span class="stat-value"><%= transactions.length %></span>
                </div>
            </div>
        </div>

        <!-- Transaction List -->
        <div class="transactions-section">
            <div class="transactions-header">
                <h3 class="transactions-title">
                    <i class="fas fa-history me-2"></i>Transaction History
                </h3>
                <a href="#" class="view-all-btn">View All</a>
            </div>
            <ul class="transaction-list">
  <% if (transactions.length > 0) { %>
    <% transactions.forEach(tx => { %>
      <li class="transaction-item">
        <div class="transaction-column date">
          <%= new Date(tx.date).toLocaleDateString() %>
        </div>
        <div class="transaction-column description">
          <%= tx.description || '-' %>
        </div>
        <div class="transaction-column type">
          <%= tx.type %>
        </div>
        <div class="transaction-column amount <%= tx.type === 'credit' ? 'positive' : 'negative' %>">
          <%= tx.type === 'credit' ? '+' : '-' %>₹<%= tx.amount.toFixed(2) %>
        </div>
      </li>
    <% }) %>
  <% } else { %>
    <li class="transaction-item">
      <div class="transaction-column description" style="flex: 100%; text-align: center;">
        No transactions yet.
      </div>
    </li>
  <% } %>
</ul>

<!-- Pagination goes OUTSIDE the <ul> -->
<% if (totalPages > 0) { %>
<div class="pagination">
  <div class="pagination-info">
    Showing <%= (currentPage - 1) * 5 + 1 %> to <%= Math.min(currentPage * 5, totalTransactions) %> of <%= totalTransactions %> transactions
  </div>
  <div class="pagination-buttons">
    <% if (currentPage > 1) { %>
      <a href="/transactionHistory?page=<%= currentPage - 1 %>" class="pagination-button">&laquo;</a>
    <% } else { %>
      <span class="pagination-button disabled">&laquo;</span>
    <% } %>

    <% if (startPage > 1) { %>
      <a href="/transactionHistory?page=1" class="pagination-button">1</a>
      <% if (startPage > 2) { %>
        <span class="pagination-ellipsis">...</span>
      <% } %>
    <% } %>

    <% for (let i = startPage; i <= endPage; i++) { %>
      <% if (i === currentPage) { %>
        <span class="pagination-button active"><%= i %></span>
      <% } else { %>
        <a href="/transactionHistory?page=<%= i %>" class="pagination-button"><%= i %></a>
      <% } %>
    <% } %>

    <% if (endPage < totalPages) { %>
      <% if (endPage < totalPages - 1) { %>
        <span class="pagination-ellipsis">...</span>
      <% } %>
      <a href="/transactionHistory?page=<%= totalPages %>" class="pagination-button"><%= totalPages %></a>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <a href="/transactionHistory?page=<%= currentPage + 1 %>" class="pagination-button">&raquo;</a>
    <% } else { %>
      <span class="pagination-button disabled">&raquo;</span>
    <% } %>
  </div>
</div>
<% } %>


            </ul>
        </div>
    </div>

        <!-- Quick Actions (Commented out as in original code) -->
        <!-- <div class="quick-actions">
            <a href="#" class="action-card">
                <div class="action-icon">
                    <i class="fas fa-plus"></i>
                </div>
                <div class="action-title">Add Money</div>
            </a>
            <a href="#" class="action-card">
                <div class="action-icon">
                    <i class="fas fa-paper-plane"></i>
                </div>
                <div class="action-title">Send Money</div>
            </a>
            <a href="#" class="action-card">
                <div class="action-icon">
                    <i class="fas fa-download"></i>
                </div>
                <div class="action-title">Withdraw</div>
            </a>
            <a href="#" class="action-card">
                <div class="action-icon">
                    <i class="fas fa-receipt"></i>
                </div>
                <div class="action-title">Statements</div>
            </a>
        </div> -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        // Add interactive effects
        document.addEventListener('DOMContentLoaded', function() {
            // Add click handlers for action cards
            document.querySelectorAll('.action-card').forEach(card => {
                card.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    // Add click animation
                    this.style.transform = 'translateY(-5px) scale(0.98)';
                    setTimeout(() => {
                        this.style.transform = '';
                    }, 150);
                    
                    console.log('Action clicked:', this.querySelector('.action-title').textContent);
                });
            });

            // Add hover effect to transaction items
            document.querySelectorAll('.transaction-item').forEach(item => {
                item.addEventListener('click', function() {
                    // Add ripple effect
                    const ripple = document.createElement('div');
                    ripple.style.cssText = `
                        position: absolute;
                        border-radius: 50%;
                        background: rgba(189, 213, 235, 0.3);
                        transform: scale(0);
                        animation: ripple 0.6s linear;
                        pointer-events: none;
                    `;
                    
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    ripple.style.width = ripple.style.height = size + 'px';
                    ripple.style.left = (rect.width / 2 - size / 2) + 'px';
                    ripple.style.top = (rect.height / 2 - size / 2) + 'px';
                    
                    this.style.position = 'relative';
                    this.appendChild(ripple);
                    
                    setTimeout(() => {
                        ripple.remove();
                    }, 600);
                });
            });

            // Add CSS animation for ripple
            const style = document.createElement('style');
            style.textContent = `
                @keyframes ripple {
                    to {
                        transform: scale(4);
                        opacity: 0;
                    }
                }
            `;
            document.head.appendChild(style);

            // Add floating animation to wallet card
            const walletCard = document.querySelector('.wallet-main-card');
            let floatDirection = 1;
            
            setInterval(() => {
                walletCard.style.transform += ` translateY(${floatDirection * 2}px)`;
                floatDirection *= -1;
            }, 3000);
        });
    </script>
</body>
</html>