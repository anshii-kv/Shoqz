<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile - SHOQZ</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.12/sweetalert2.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito Sans', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        .profile-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .card {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        }

        .card-body {
            padding: 2rem;
        }

        .card-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .card-title::after {
            content: "";
            display: block;
            width: 40px;
            height: 3px;
            background: linear-gradient(45deg, #bdd5eb, #a9c1d6);
            margin-top: 10px;
            border-radius: 2px;
        }

        .list-group-item {
            padding: 1rem 0;
            border: none;
            transition: all 0.3s ease;
        }

        .list-group-item:hover {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 10px;
        }

        .list-group-item a {
            color: #333;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem;
        }

        .list-group-item a:hover {
            color: #a9c1d6;
        }

        .btn-primary {
            background: linear-gradient(45deg, #bdd5eb, #a9c1d6);
            border: none;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: linear-gradient(45deg, #a9c1d6, #bdd5eb);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(189, 213, 235, 0.3);
        }

        /* Wallet Card Styles (unchanged) */
        .wallet-card {
            background: linear-gradient(135deg, #bdd5eb 0%, #a9c1d6 100%);
            border: none;
            border-radius: 15px;
            color: white;
            box-shadow: 0 8px 25px rgba(189, 213, 235, 0.3);
            transition: all 0.3s ease;
            margin-bottom: 20px;
        }

        .wallet-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 35px rgba(189, 213, 235, 0.4);
        }

        .wallet-card .card-body {
            padding: 30px;
        }

        .wallet-card .card-title {
            color: white;
            font-size: 28px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .wallet-card .card-title::after {
            background: rgba(255, 255, 255, 0.3);
        }

        .wallet-balance {
            font-size: 36px;
            font-weight: bold;
            color: white;
            margin: 0;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        .wallet-balance-label {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 10px;
        }

        .wallet-actions {
            margin-top: 25px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .wallet-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .wallet-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            border-color: rgba(255, 255, 255, 0.5);
            color: white;
            transform: translateY(-2px);
        }

        /* Other styles (unchanged) */
        .genric-btn {
            display: inline-block;
            padding: 10px 20px;
            margin: 5px;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s;
            border-radius: 25px;
            font-weight: 500;
        }

        .genric-btn:hover {
            background-color: #bdd5eb;
            color: #fff;
            transform: translateY(-2px);
        }

        .danger-border {
            border: 2px solid #bdd5eb;
            color: #bdd5eb;
        }

        .danger-border:hover {
            background-color: #bdd5eb;
            color: #fff;
        }

        .action-buttons {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .action-button {
            padding: 8px 16px;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            border: 2px solid #ccc;
            border-radius: 20px;
            transition: all 0.3s;
            font-weight: 500;
            min-width: 100px;
        }

        .action-button:hover {
            background-color: #bdd5eb;
            color: #fff;
            border-color: #bdd5eb;
            transform: translateY(-2px);
        }

        .return-button {
            background-color: #f8d7da;
            border-color: #f5c6cb;
            color: #bdd5eb;
        }

        .return-button:hover {
            background-color: #f5c6cb;
            border-color: #f5c6cb;
            color: #721c24;
        }

        .table-container {
            display: none;
            max-width: 800px;
            margin: 20px auto;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
        }

        thead {
            background: linear-gradient(45deg, #bdd5eb, #a9c1d6);
            color: #fff;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        th {
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        tbody tr:hover {
            background-color: #f0f0f0;
            transform: scale(1.01);
            transition: all 0.3s;
        }

        .balance-row {
            background: linear-gradient(45deg, #bdd5eb, #a9c1d6);
            color: #fff;
            text-align: center;
            font-weight: bold;
            font-size: 1.2em;
        }

        .invoice-btn {
            display: inline-block;
            text-decoration: none;
            background: linear-gradient(45deg, #bdd5eb, #a9c1d6);
            border-radius: 20px;
            padding: 10px 20px;
            color: #ffffff;
            font-weight: bold;
            margin-right: 10px;
            transition: all 0.3s;
        }

        .invoice-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(189, 213, 235, 0.3);
            color: white;
        }

        .status-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-placed { background-color: #d4edda; color: #155724; }
        .status-pending { background-color: #fff3cd; color: #856404; }
        .status-delivered { background-color: #d1ecf1; color: #0c5460; }
        .status-cancelled { background-color: #f8d7da; color: #721c24; }
        .status-returned { background-color: #e2e3e5; color: #383d41; }

        /* Profile Image Styles (unchanged) */
        .profile-image-container {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
        }

        .profile-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid #fff;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .profile-image:hover {
            transform: scale(1.05);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
        }

        .profile-image-placeholder {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: linear-gradient(135deg, #bdd5eb 0%, #a9c1d6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
            border: 5px solid #fff;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .profile-image-placeholder:hover {
            transform: scale(1.05);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
        }

        .image-actions {
            position: absolute;
            top: 10px;
            right: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .image-action-btn {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .edit-btn {
            background: linear-gradient(45deg, #bdd5eb, #a9c1d6);
            color: white;
        }

        .edit-btn:hover {
            background: linear-gradient(45deg, #a9c1d6, #bdd5eb);
            transform: scale(1.1);
            box-shadow: 0 6px 20px rgba(189, 213, 235, 0.3);
        }

        .delete-btn {
            background: linear-gradient(45deg, #f44336, #da190b);
            color: white;
        }

        .delete-btn:hover {
            background: linear-gradient(45deg, #da190b, #f44336);
            transform: scale(1.1);
            box-shadow: 0 6px 20px rgba(244, 67, 54, 0.3);
        }

        .file-input {
            display: none;
        }

        .user-info-section {
            display: flex;
            align-items: flex-start;
            gap: 30px;
        }

        .user-details {
            flex: 1;
        }

        .form-control:focus {
            border-color: #bdd5eb;
            box-shadow: 0 0 0 0.2rem rgba(189, 213, 235, 0.25);
        }

        .btn-outline-primary {
            color: #bdd5eb;
            border-color: #bdd5eb;
        }

        .btn-outline-primary:hover {
            background-color: #bdd5eb;
            border-color: #bdd5eb;
        }

        @media (max-width: 768px) {
            .profile-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .card-body {
                padding: 1.5rem;
            }

            .user-info-section {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .profile-image,
            .profile-image-placeholder {
                width: 120px;
                height: 120px;
            }

            .image-actions {
                top: 5px;
                right: 5px;
            }

            .wallet-card .card-body {
                padding: 20px;
            }

            .wallet-balance {
                font-size: 28px;
            }

            .wallet-actions {
                flex-direction: column;
                gap: 10px;
            }

            .wallet-btn {
                text-align: center;
                justify-content: center;
            }
        }

        @media (max-width: 576px) {
            body {
                padding: 1rem 0.5rem;
            }

            .card-body {
                padding: 1rem;
            }

            .card-title {
                font-size: 1.2rem;
            }

            .list-group-item a {
                font-size: 0.9rem;
            }

            .btn-primary {
                padding: 0.5rem 1rem;
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <!-- Header Section -->
    <section style="background: rgba(255, 255, 255, 0.95); box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1); backdrop-filter: blur(10px);">
        <div class="profile-container py-4">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb__text pt-3">
                        <h4><i class="fas fa-user-circle me-2"></i> My Profile</h4>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Profile</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); min-height: 100vh;">
        <div class="profile-container py-5">
            <div class="profile-grid">
                <!-- Sidebar -->
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-user-cog me-2"></i> Account Menu</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <a href="/editProfile" class="text-decoration-none" onclick="toggleProfileForm()">
                                    <i class="fas fa-edit me-2"></i> Edit Profile
                                </a>
                            </li>
                            <li class="list-group-item">
                                <a href="/order" class="text-decoration-none" onclick="toggleOrders()">
                                    <i class="fas fa-file-alt me-2"></i> My Orders
                                </a>
                            </li>
                            <li class="list-group-item">
                                <a href="/address" class="text-decoration-none" onclick="toggleAddress()">
                                    <i class="fas fa-map-marked-alt me-2"></i> Manage Addresses
                                </a>
                            </li>
                            <li class="list-group-item">
                                <a href="/changepass" class="text-decoration-none" onclick="togglePasswordForm()">
                                    <i class="fas fa-key me-2"></i> Change Password
                                </a>
                            </li>
                            <li class="list-group-item">
                                <a href="/referalCode" class="text-decoration-none toggle-button" onclick="toggleWalletHistory()">
                                    <i class="fas fa-wallet me-2"></i> Referral Code
                                </a>
                            </li>
                            <li class="list-group-item">
                                <a href="/transactionHistory" class="text-decoration-none toggle-button" onclick="toggleWalletHistory()">
                                    <i class="fas fa-wallet me-2"></i> Transaction History
                                </a>
                            </li>
                            <li class="list-group-item">
                                <button class="btn btn-primary w-100" onclick="logout()">
                                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.12/sweetalert2.min.js"></script>
    <!-- Add your JavaScript functions here if needed -->
</body>
</html>